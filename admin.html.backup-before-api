<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TechStore | Admin Dashboard</title>

<style>
:root {
    --bg: #f5f7fb;
    --panel: #ffffff;
    --text: #182230;
    --muted: #7b8494;
    --border: #e8ecf2;
    --primary: #5b5ce2;
    --sidebar: #171a2b;
    --green: #159b69;
    --red: #d94747;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
}

button, input, select, textarea {
    font: inherit;
}

button {
    cursor: pointer;
}

.layout {
    display: flex;
    min-height: 100vh;
}

/* SIDEBAR */

.sidebar {
    width: 250px;
    background: var(--sidebar);
    color: white;
    padding: 25px 17px;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 10px 32px;
    font-size: 21px;
    font-weight: 750;
}

.brand-icon {
    width: 39px;
    height: 39px;
    display: grid;
    place-items: center;
    background: var(--primary);
    border-radius: 12px;
    font-size: 22px;
}

.nav-label {
    padding: 10px 12px;
    color: #858ba2;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
}

.nav-item {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 13px;
    border: 0;
    background: transparent;
    color: #a9afc2;
    padding: 13px 14px;
    border-radius: 10px;
    text-align: left;
    margin-bottom: 5px;
    transition: .2s;
}

.nav-item:hover,
.nav-item.active {
    background: #2a2d46;
    color: white;
}

.nav-item.active {
    box-shadow: inset 3px 0 var(--primary);
}

.nav-icon {
    width: 22px;
    text-align: center;
    font-size: 17px;
}

.sidebar-bottom {
    margin-top: auto;
    padding: 20px 10px 0;
}

.owner-card {
    border-top: 1px solid #33364a;
    padding-top: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
}

.avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #d9d7ff;
    color: #4948bb;
    font-weight: 800;
}

.owner-name {
    font-size: 13px;
    font-weight: 650;
}

.owner-role {
    font-size: 11px;
    color: #989eb4;
    margin-top: 4px;
}

/* MAIN CONTENT */

.main {
    flex: 1;
    min-width: 0;
}

.topbar {
    height: 76px;
    background: white;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 35px;
    gap: 20px;
}

.breadcrumb {
    color: var(--muted);
    font-size: 13px;
}

.breadcrumb strong {
    color: var(--text);
}

.top-actions {
    display: flex;
    align-items: center;
    gap: 17px;
}

.top-status {
    color: var(--green);
    font-size: 12px;
    font-weight: 700;
}

.top-status::before {
    content: "";
    width: 7px;
    height: 7px;
    display: inline-block;
    background: var(--green);
    border-radius: 50%;
    margin-right: 7px;
}

.content {
    padding: 32px 35px;
    max-width: 1600px;
    margin: auto;
}

.page-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 18px;
    margin-bottom: 28px;
}

h1 {
    font-size: 27px;
    letter-spacing: -.8px;
}

.subtitle {
    margin-top: 8px;
    font-size: 13px;
    color: var(--muted);
}

.btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    border: 0;
    border-radius: 9px;
    padding: 12px 17px;
    font-weight: 650;
    font-size: 13px;
    transition: .2s;
}

.btn-primary {
    background: var(--primary);
    color: white;
    box-shadow: 0 4px 10px #5b5ce226;
}

.btn-primary:hover {
    background: #4849c7;
    transform: translateY(-1px);
}

.btn-light {
    background: white;
    color: var(--text);
    border: 1px solid var(--border);
}

/* STAT CARDS */

.stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    margin-bottom: 28px;
}

.stat-card {
    background: var(--panel);
    padding: 22px;
    border: 1px solid var(--border);
    border-radius: 13px;
}

.stat-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.stat-label {
    color: var(--muted);
    font-size: 12px;
    font-weight: 550;
}

.stat-icon {
    width: 39px;
    height: 39px;
    display: grid;
    place-items: center;
    border-radius: 11px;
    font-size: 19px;
}

.purple { background: #efedff; }
.blue { background: #e8f3ff; }
.orange { background: #fff1df; }
.green { background: #e2f8ef; }

.stat-number {
    margin-top: 19px;
    font-size: 28px;
    font-weight: 750;
    letter-spacing: -.8px;
}

.stat-note {
    margin-top: 8px;
    font-size: 11px;
    color: var(--muted);
}

/* PRODUCT TABLE */

.panel {
    background: white;
    border: 1px solid var(--border);
    border-radius: 13px;
    overflow: hidden;
}

.panel-heading {
    padding: 22px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    flex-wrap: wrap;
}

.panel-title {
    font-size: 17px;
    font-weight: 750;
}

.panel-description {
    font-size: 12px;
    color: var(--muted);
    margin-top: 6px;
}

.filters {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

.search-box,
.filter-select {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px 12px;
    background: white;
    color: var(--text);
    outline: none;
    font-size: 12px;
}

.search-box {
    width: 210px;
}

.search-box:focus,
.filter-select:focus,
.form-control:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px #5b5ce21a;
}

.table-wrap {
    width: 100%;
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    white-space: nowrap;
}

thead {
    background: #f9fafc;
}

th {
    padding: 14px 24px;
    color: #858da0;
    font-size: 10px;
    letter-spacing: .8px;
    text-transform: uppercase;
    font-weight: 750;
}

td {
    padding: 16px 24px;
    border-top: 1px solid #f0f2f6;
    font-size: 12px;
}

.product-info {
    display: flex;
    align-items: center;
    gap: 13px;
}

.product-thumb {
    width: 52px;
    height: 52px;
    border: 1px solid var(--border);
    background: #f7f8fb;
    border-radius: 9px;
    display: grid;
    place-items: center;
    overflow: hidden;
    flex-shrink: 0;
    font-size: 24px;
}

.product-thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: white;
}

.product-name {
    font-size: 12px;
    font-weight: 700;
}

.product-id {
    margin-top: 5px;
    color: var(--muted);
    font-size: 10px;
}

.category-tag {
    display: inline-block;
    padding: 6px 9px;
    background: #f0efff;
    color: #5b53c9;
    border-radius: 6px;
    font-size: 10px;
    font-weight: 700;
}

.status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 9px;
    border-radius: 6px;
    background: #e7f8ef;
    color: #14835a;
    font-size: 10px;
    font-weight: 700;
}

.status::before {
    content: "";
    width: 5px;
    height: 5px;
    background: currentColor;
    border-radius: 50%;
}

.action-btn {
    background: white;
    border: 1px solid var(--border);
    padding: 7px 10px;
    border-radius: 7px;
    margin-right: 5px;
    color: var(--text);
    font-size: 11px;
}

.action-btn:hover {
    background: #f2f3ff;
}

.delete-btn {
    color: var(--red);
}

.empty-state {
    padding: 45px 20px;
    text-align: center;
    color: var(--muted);
    font-size: 13px;
}

.footer-note {
    color: var(--muted);
    text-align: center;
    font-size: 11px;
    padding: 22px 0;
}

/* ADD PRODUCT MODAL */

.modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(18, 21, 36, .58);
    z-index: 100;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    overflow-y: auto;
}

.modal-backdrop.open {
    display: flex;
}

.modal {
    background: white;
    width: 100%;
    max-width: 680px;
    border-radius: 16px;
    box-shadow: 0 25px 80px #0003;
    margin: auto;
}

.modal-header {
    padding: 24px 26px;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.modal-header h2 {
    font-size: 20px;
}

.modal-header p {
    font-size: 12px;
    color: var(--muted);
    margin-top: 7px;
}

.close-btn {
    width: 34px;
    height: 34px;
    border: 0;
    background: #f2f3f7;
    border-radius: 8px;
    font-size: 19px;
}

.modal-body {
    padding: 25px 26px;
}

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 19px;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.form-group.full {
    grid-column: 1 / -1;
}

.form-group label {
    font-size: 12px;
    font-weight: 700;
}

.form-control {
    width: 100%;
    padding: 12px;
    border: 1px solid #dfe3ec;
    border-radius: 8px;
    outline: none;
    font-size: 12px;
    background: white;
}

textarea.form-control {
    resize: vertical;
    min-height: 85px;
}

.upload-box {
    border: 1.5px dashed #cdd2e0;
    background: #fafbff;
    border-radius: 10px;
    min-height: 145px;
    padding: 20px;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 8px;
}

.upload-icon {
    font-size: 28px;
}

.upload-box p {
    font-size: 12px;
    font-weight: 700;
}

.upload-box small {
    font-size: 10px;
    color: var(--muted);
}

.upload-box input {
    max-width: 230px;
    font-size: 11px;
}

.image-preview {
    display: none;
    max-width: 150px;
    max-height: 130px;
    object-fit: contain;
    margin-top: 8px;
}

.form-help {
    font-size: 10px;
    color: var(--muted);
    line-height: 1.6;
}

.modal-footer {
    padding: 19px 26px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: flex-end;
    gap: 10px;
}

.toast {
    position: fixed;
    bottom: 25px;
    right: 25px;
    z-index: 200;
    padding: 15px 20px;
    background: #171a2b;
    color: white;
    border-radius: 10px;
    font-size: 13px;
    box-shadow: 0 8px 30px #0002;
    display: none;
    max-width: calc(100vw - 40px);
}

.toast.show {
    display: block;
}

/* MOBILE */

@media (max-width: 1100px) {
    .stats {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .sidebar {
        width: 210px;
    }

    .content {
        padding: 25px 20px;
    }

    .topbar {
        padding: 0 20px;
    }
}

@media (max-width: 720px) {
    .layout {
        display: block;
    }

    .sidebar {
        width: 100%;
        padding: 13px;
    }

    .brand {
        padding: 0 5px 14px;
    }

    .sidebar nav {
        display: flex;
        gap: 5px;
        overflow-x: auto;
    }

    .nav-label,
    .sidebar-bottom {
        display: none;
    }

    .nav-item {
        min-width: max-content;
        width: auto;
        margin: 0;
        padding: 10px;
    }

    .topbar {
        height: 57px;
        padding: 0 16px;
    }

    .content {
        padding: 22px 14px;
    }

    .page-heading {
        align-items: flex-start;
    }

    h1 {
        font-size: 22px;
    }

    .page-heading > .btn {
        padding: 10px;
        font-size: 11px;
    }

    .stats {
        gap: 10px;
    }

    .stat-card {
        padding: 15px;
    }

    .stat-number {
        font-size: 23px;
    }

    .stat-label {
        font-size: 11px;
    }

    .panel-heading {
        padding: 17px;
    }

    .search-box {
        width: 100%;
    }

    .filters {
        width: 100%;
    }

    .filter-select {
        flex: 1;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }

    .form-group.full {
        grid-column: auto;
    }

    .modal-header,
    .modal-body,
    .modal-footer {
        padding: 18px;
    }
}
</style>
</head>

<body>

<div class="layout">

    <aside class="sidebar">
        <div class="brand">
            <div class="brand-icon">T</div>
            <span>TechStore</span>
        </div>

        <div class="nav-label">Workspace</div>

        <nav>
            <button class="nav-item active" type="button" data-section="dashboard">
                <span class="nav-icon">▦</span> Dashboard
            </button>

            <button class="nav-item" type="button" data-section="products">
                <span class="nav-icon">▣</span> Products
            </button>

            <button class="nav-item" type="button" data-section="orders">
                <span class="nav-icon">▤</span> Orders
            </button>

            <button class="nav-item" type="button" data-section="customers">
                <span class="nav-icon">♙</span> Customers
            </button>
        </nav>

        <div class="nav-label" style="margin-top:22px">Preferences</div>

        <nav>
            <button class="nav-item" type="button" data-section="settings">
                <span class="nav-icon">⚙</span> Settings
            </button>
        </nav>

        <div class="sidebar-bottom">
            <div class="owner-card">
                <div class="avatar">O</div>
                <div>
                    <div class="owner-name">Store Owner</div>
                    <div class="owner-role">Administrator</div>
                </div>
            </div>
        </div>
    </aside>

    <main class="main">

        <header class="topbar">
            <div class="breadcrumb">Workspace / <strong id="breadcrumb">Dashboard</strong></div>
            <div class="top-actions">
                <span class="top-status">Store dashboard</span>
            </div>
        </header>

        <div class="content">

            <section class="page-heading">
                <div>
                    <h1 id="pageTitle">Dashboard Overview</h1>
                    <p class="subtitle" id="pageSubtitle">
                        Manage your store and products from one place.
                    </p>
                </div>

                <button class="btn btn-primary" id="openAddProduct">
                    <span>＋</span> Add Product
                </button>
            </section>

            <section class="stats">
                <div class="stat-card">
                    <div class="stat-top">
                        <span class="stat-label">Total Products</span>
                        <span class="stat-icon purple">▣</span>
                    </div>
                    <div class="stat-number" id="totalProducts">0</div>
                    <div class="stat-note">Products in this browser demo</div>
                </div>

                <div class="stat-card">
                    <div class="stat-top">
                        <span class="stat-label">Mobile Products</span>
                        <span class="stat-icon blue">📱</span>
                    </div>
                    <div class="stat-number" id="mobileCount">0</div>
                    <div class="stat-note">Products in mobile category</div>
                </div>

                <div class="stat-card">
                    <div class="stat-top">
                        <span class="stat-label">Laptop Products</span>
                        <span class="stat-icon orange">💻</span>
                    </div>
                    <div class="stat-number" id="laptopCount">0</div>
                    <div class="stat-note">Products in laptop category</div>
                </div>

                <div class="stat-card">
                    <div class="stat-top">
                        <span class="stat-label">Inventory Items</span>
                        <span class="stat-icon green">▤</span>
                    </div>
                    <div class="stat-number" id="totalStock">0</div>
                    <div class="stat-note">Total demo stock quantity</div>
                </div>
            </section>

            <section class="panel" id="productsPanel">

                <div class="panel-heading">
                    <div>
                        <div class="panel-title" id="tableTitle">Product Management</div>
                        <p class="panel-description" id="tableDescription">
                            Manage product details, images, pricing and inventory.
                        </p>
                    </div>

                    <div class="filters">
                        <input class="search-box" type="search" id="searchInput"
                               placeholder="Search products...">

                        <select class="filter-select" id="categoryFilter">
                            <option value="all">All categories</option>
                            <option value="mobile">Mobiles</option>
                            <option value="laptop">Laptops</option>
                        </select>
                    </div>
                </div>

                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Category</th>
                                <th>Price</th>
                                <th>Stock</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="productTable"></tbody>
                    </table>
                </div>

                <div class="empty-state" id="emptyState">
                    No products yet. Select <strong>Add Product</strong> to try the interface.
                </div>

            </section>

            <div class="footer-note">
                TechStore Admin UI · Demo interface — not connected to a production backend.
            </div>

        </div>
    </main>
</div>

<!-- ADD PRODUCT MODAL -->

<div class="modal-backdrop" id="productModal">
    <div class="modal">

        <div class="modal-header">
            <div>
                <h2>Add New Product</h2>
                <p>Enter product details and select a product image.</p>
            </div>
            <button class="close-btn" id="closeModal" aria-label="Close">×</button>
        </div>

        <form id="productForm">

            <div class="modal-body">
                <div class="form-grid">

                    <div class="form-group full">
                        <label for="productName">Product Name *</label>
                        <input class="form-control" id="productName"
                               type="text" placeholder="e.g. Apple iPhone 17" required>
                    </div>

                    <div class="form-group">
                        <label for="category">Category *</label>
                        <select class="form-control" id="category" required>
                            <option value="mobile">Mobile</option>
                            <option value="laptop">Laptop</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="brand">Brand *</label>
                        <input class="form-control" id="brand"
                               type="text" placeholder="e.g. Apple" required>
                    </div>

                    <div class="form-group">
                        <label for="price">Price (₹) *</label>
                        <input class="form-control" id="price"
                               type="number" min="1" step="1" placeholder="79999" required>
                    </div>

                    <div class="form-group">
                        <label for="stock">Stock Quantity *</label>
                        <input class="form-control" id="stock"
                               type="number" min="0" step="1" placeholder="25" required>
                    </div>

                    <div class="form-group full">
                        <label for="description">Product Description</label>
                        <textarea class="form-control" id="description"
                                  placeholder="Enter product specifications..."></textarea>
                    </div>

                    <div class="form-group full">
                        <label for="productImage">Product Image *</label>

                        <div class="upload-box">
                            <div class="upload-icon">☁</div>
                            <p>Select a mobile or laptop image</p>
                            <small>Choose JPG, PNG or WebP · Maximum 5 MB</small>
                            <input type="file" id="productImage"
                                   accept="image/jpeg,image/png,image/webp" required>
                            <img class="image-preview" id="imagePreview" alt="Selected product preview">
                        </div>

                        <p class="form-help">
                            Demo only: the selected image is previewed in this browser.
                            It is not uploaded to a server or Amazon S3.
                        </p>
                    </div>

                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-light" id="cancelModal">Cancel</button>
                <button type="submit" class="btn btn-primary">Add Product</button>
            </div>

        </form>
    </div>
</div>

<div class="toast" id="toast"></div>

<script>
const STORAGE_KEY = "techstore_admin_demo_products_v1";

let products = [];
let selectedImage = "";
let nextId = 1;

try {
    const stored = localStorage.getItem(STORAGE_KEY);
    products = stored ? JSON.parse(stored) : [];
    if (!Array.isArray(products)) products = [];
} catch (error) {
    products = [];
}

nextId = products.reduce((max, p) => Math.max(max, Number(p.id) || 0), 0) + 1;

const $ = id => document.getElementById(id);

const modal = $("productModal");
const form = $("productForm");
const imageInput = $("productImage");
const imagePreview = $("imagePreview");

function escapeHTML(value) {
    return String(value ?? "").replace(/[&<>"']/g, char => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
    })[char]);
}

function money(value) {
    return Number(value).toLocaleString("en-IN", {
        style: "currency",
        currency: "INR",
        maximumFractionDigits: 0
    });
}

function showToast(message) {
    const toast = $("toast");
    toast.textContent = message;
    toast.classList.add("show");
    clearTimeout(showToast.timer);
    showToast.timer = setTimeout(() => toast.classList.remove("show"), 3500);
}

function saveDemoData() {
    try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(products));
        return true;
    } catch (error) {
        showToast("Browser storage is full. Try a smaller image.");
        return false;
    }
}

function renderStats() {
    $("totalProducts").textContent = products.length;
    $("mobileCount").textContent = products.filter(p => p.category === "mobile").length;
    $("laptopCount").textContent = products.filter(p => p.category === "laptop").length;
    $("totalStock").textContent = products.reduce((sum, p) => sum + Number(p.stock || 0), 0);
}

function renderProducts() {
    const search = $("searchInput").value.toLowerCase().trim();
    const category = $("categoryFilter").value;

    const filtered = products.filter(p => {
        const matchesSearch =
            p.name.toLowerCase().includes(search) ||
            p.brand.toLowerCase().includes(search);

        return matchesSearch && (category === "all" || p.category === category);
    });

    $("productTable").innerHTML = filtered.map(p => `
        <tr>
            <td>
                <div class="product-info">
                    <div class="product-thumb">
                        ${p.image
                            ? `<img src="${p.image}" alt="">`
                            : (p.category === "mobile" ? "📱" : "💻")}
                    </div>
                    <div>
                        <div class="product-name">${escapeHTML(p.name)}</div>
                        <div class="product-id">ID: TS-${String(p.id).padStart(4, "0")}</div>
                    </div>
                </div>
            </td>
            <td><span class="category-tag">${escapeHTML(p.category)}</span></td>
            <td><strong>${money(p.price)}</strong></td>
            <td>${Number(p.stock)}</td>
            <td><span class="status">Active</span></td>
            <td>
                <button class="action-btn" data-action="view" data-id="${p.id}">View</button>
                <button class="action-btn delete-btn" data-action="delete" data-id="${p.id}">Delete</button>
            </td>
        </tr>
    `).join("");

    $("emptyState").style.display = filtered.length ? "none" : "block";
    renderStats();
}

function openModal() {
    form.reset();
    selectedImage = "";
    imagePreview.src = "";
    imagePreview.style.display = "none";
    modal.classList.add("open");
}

function closeModal() {
    modal.classList.remove("open");
}

$("openAddProduct").addEventListener("click", openModal);
$("closeModal").addEventListener("click", closeModal);
$("cancelModal").addEventListener("click", closeModal);

modal.addEventListener("click", event => {
    if (event.target === modal) closeModal();
});

$("searchInput").addEventListener("input", renderProducts);
$("categoryFilter").addEventListener("change", renderProducts);

imageInput.addEventListener("change", () => {
    const file = imageInput.files[0];
    selectedImage = "";

    if (!file) {
        imagePreview.style.display = "none";
        return;
    }

    const allowed = ["image/jpeg", "image/png", "image/webp"];

    if (!allowed.includes(file.type)) {
        imageInput.value = "";
        imagePreview.style.display = "none";
        showToast("Please select a JPG, PNG or WebP image.");
        return;
    }

    if (file.size > 5 * 1024 * 1024) {
        imageInput.value = "";
        imagePreview.style.display = "none";
        showToast("Image must be 5 MB or smaller.");
        return;
    }

    const reader = new FileReader();

    reader.onload = () => {
        selectedImage = reader.result;
        imagePreview.src = selectedImage;
        imagePreview.style.display = "block";
    };

    reader.readAsDataURL(file);
});

form.addEventListener("submit", event => {
    event.preventDefault();

    if (!selectedImage) {
        showToast("Please select a product image.");
        return;
    }

    const product = {
        id: nextId,
        name: $("productName").value.trim(),
        category: $("category").value,
        brand: $("brand").value.trim(),
        price: Number($("price").value),
        stock: Number($("stock").value),
        description: $("description").value.trim(),
        image: selectedImage
    };

    if (!product.name || !product.brand || product.price < 1 || product.stock < 0) {
        showToast("Please enter valid product details.");
        return;
    }

    products.unshift(product);

    if (!saveDemoData()) {
        products.shift();
        return;
    }

    nextId++;
    renderProducts();
    closeModal();
    showToast("Product added to this browser demo.");
});

$("productTable").addEventListener("click", event => {
    const button = event.target.closest("button[data-action]");
    if (!button) return;

    const id = Number(button.dataset.id);
    const product = products.find(p => p.id === id);
    if (!product) return;

    if (button.dataset.action === "view") {
        showToast(product.name + " · " + money(product.price) + " · Stock: " + product.stock);
    }

    if (button.dataset.action === "delete") {
        if (!confirm("Delete " + product.name + " from this browser demo?")) return;

        products = products.filter(p => p.id !== id);
        saveDemoData();
        renderProducts();
        showToast("Demo product deleted.");
    }
});

document.querySelectorAll(".nav-item[data-section]").forEach(button => {
    button.addEventListener("click", () => {
        const section = button.dataset.section;

        document.querySelectorAll(".nav-item").forEach(item => item.classList.remove("active"));
        button.classList.add("active");

        $("breadcrumb").textContent = button.textContent.trim();
        $("pageTitle").textContent =
            section === "dashboard" ? "Dashboard Overview" :
            section === "products" ? "Product Management" :
            section === "orders" ? "Orders" :
            section === "customers" ? "Customers" : "Settings";

        $("pageSubtitle").textContent =
            section === "products" ? "Manage product details, images, pricing and inventory." :
            section === "dashboard" ? "Manage your store and products from one place." :
            "This section is a placeholder in the current demo.";

        if (section === "products") {
            $("productsPanel").scrollIntoView({ behavior: "smooth", block: "start" });
        } else if (section !== "dashboard") {
            showToast("This section will be connected in a later step.");
        }
    });
});

renderProducts();
</script>

</body>
</html>
