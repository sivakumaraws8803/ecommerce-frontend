<!DOCTYPE html>
<html>
<head>
<title>My Orders - TechStore</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
body{font-family:Arial;background:#f5f5f5;padding:20px;color:#222}
main{max-width:800px;margin:auto}
.order{background:white;padding:20px;margin:15px 0;border-radius:10px}
a{background:#222;color:white;padding:10px;text-decoration:none}
.item{padding:10px;border-bottom:1px solid #ddd}
</style>
</head>
<body>
<main>
<h1>My Orders</h1>
<a href="/">Continue Shopping</a>
<div id="message">Loading orders...</div>
<div id="orders"></div>
</main>
<script>
async function loadOrders(){
 const message=document.getElementById("message");
 const container=document.getElementById("orders");
 try{
  const response=await fetch("/api/orders/my",{credentials:"same-origin"});
  if(response.status===401){
   location.href="/account.html?next=orders";
   return;
  }
  const data=await response.json();
  if(!response.ok) throw new Error(data.error||"Unable to load orders");
  if(!data.orders.length){
   message.textContent="No orders found. Start shopping!";
   return;
  }
  message.textContent="Your purchase history";
  data.orders.forEach(order=>{
   const card=document.createElement("div");
   card.className="order";
   const title=document.createElement("h3");
   title.textContent="Order #"+order.id;
   card.appendChild(title);
   const status=document.createElement("p");
   status.textContent="Status: "+order.status;
   card.appendChild(status);
   const date=document.createElement("p");
   date.textContent="Date: "+new Date(order.created_at).toLocaleString();
   card.appendChild(date);
   order.items.forEach(item=>{
    const row=document.createElement("div");
    row.className="item";
    row.textContent=item.product_name+" × "+item.quantity+
     " — ₹"+Number(item.unit_price).toFixed(2);
    card.appendChild(row);
   });
   const total=document.createElement("h3");
   total.textContent="Total: ₹"+Number(order.total_amount).toFixed(2);
   card.appendChild(total);
   container.appendChild(card);
  });
 }catch(error){
  message.textContent=error.message;
 }
}
loadOrders();
</script>
</body>
</html>
