```css
/* =========================
   THEME VARIABLES
========================= */

:root {
    --bg: #ffffff;
    --card: #ffffff;
    --surface: #f4f5f7;
    --text: #111111;
    --muted: #666a73;
    --border: #e5e7eb;
    --blue: #075bea;
    --shadow: 0 8px 25px rgba(0, 0, 0, 0.07);
}

:root[data-theme="dark"] {
    color-scheme: dark;

    --bg: #101114;
    --card: #191b20;
    --surface: #22242a;
    --text: #f7f7f8;
    --muted: #a4a8b0;
    --border: #34363d;
    --blue: #367cff;
    --shadow: 0 8px 25px rgba(0, 0, 0, 0.25);
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: var(--bg);
    color: var(--text);
    transition: background 0.2s, color 0.2s;
}

a {
    color: inherit;
    text-decoration: none;
}

button,
input {
    font: inherit;
}

button {
    cursor: pointer;
}

/* =========================
   NAVIGATION
========================= */

.navbar {
    height: 70px;
    padding: 0 5%;
    display: flex;
    align-items: center;
    gap: 30px;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
}

.logo {
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -1px;
    white-space: nowrap;
}

.logo span {
    color: var(--blue);
}

nav {
    display: flex;
    gap: 23px;
    align-items: center;
}

nav a {
    font-size: 12px;
    padding: 27px 0;
    border-bottom: 2px solid transparent;
}

nav a:hover,
nav a.active {
    color: var(--blue);
    border-bottom-color: var(--blue);
}

.header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
}

#search {
    width: 210px;
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: 30px;
    background: var(--surface);
    color: var(--text);
    outline: none;
}

#search:focus {
    border-color: var(--blue);
}

.icon-button,
.menu-button {
    border: 0;
    background: transparent;
    color: var(--text);
    font-size: 23px;
    position: relative;
}

.cart-button span {
    position: absolute;
    top: -7px;
    right: -8px;
    background: #ef233c;
    color: white;
    border-radius: 50%;
    min-width: 17px;
    height: 17px;
    display: grid;
    place-items: center;
    font-size: 10px;
}

.menu-button {
    display: none;
}

/* =========================
   HERO SECTION
========================= */

.hero {
    position: relative;
    min-height: 380px;
    padding: 55px 9.5%;
    display: flex;
    align-items: center;
    overflow: hidden;
    background:
        radial-gradient(ellipse at 75% 50%, #61402f 0%, transparent 35%),
        linear-gradient(110deg, #050505, #17100d 60%, #050505);
    color: white;
}

.hero-content {
    max-width: 520px;
    position: relative;
    z-index: 2;
}

.eyebrow {
    letter-spacing: 3px;
    font-size: 13px;
    margin-bottom: 15px;
}

.hero h1 {
    font-size: clamp(38px, 4vw, 58px);
    letter-spacing: -2px;
    margin-bottom: 5px;
}

.hero h2 {
    font-size: clamp(25px, 3vw, 39px);
    letter-spacing: -1px;
    margin-bottom: 12px;
}

.hero-description {
    color: #dddddd;
    font-size: 15px;
    line-height: 1.7;
    max-width: 440px;
    margin-bottom: 22px;
}

.hero-image {
    position: absolute;
    right: 7%;
    top: 0;
    height: 100%;
    width: 47%;
    object-fit: cover;
    object-position: center;
    opacity: 0.82;
    mix-blend-mode: screen;
    mask-image: linear-gradient(90deg, transparent, black 30%);
}

.hero-buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
}

.button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 9px;
    padding: 12px 22px;
    border-radius: 30px;
    font-size: 12px;
    font-weight: bold;
    border: 1px solid transparent;
    transition: 0.2s;
}

.button:hover {
    transform: translateY(-2px);
}

.primary-button {
    background: var(--blue);
    color: white;
}

.primary-button:hover {
    background: #0048c9;
}

.outline-button {
    border-color: white;
    color: white;
}

.hero-dots {
    display: flex;
    gap: 9px;
    margin-top: 24px;
}

.hero-dots span {
    height: 8px;
    width: 8px;
    border: 1px solid white;
    border-radius: 50%;
}

.hero-dots span:first-child {
    background: white;
}

/* =========================
   BENEFITS
========================= */

.benefits {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding: 18px 7%;
    border-bottom: 1px solid var(--border);
    gap: 15px;
}

.benefit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
}

.benefit > span {
    font-size: 27px;
}

.benefit strong,
.benefit small {
    display: block;
}

.benefit strong {
    font-size: 12px;
    margin-bottom: 5px;
}

.benefit small {
    color: var(--muted);
    font-size: 10px;
}

/* =========================
   CATEGORIES
========================= */

.section-container {
    width: 90%;
    max-width: 1440px;
    margin: auto;
}

.categories {
    padding-top: 20px;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
}

.category-card {
    min-width: 0;
    min-height: 95px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 5px;
    padding: 12px;
    border-radius: 12px;
    background: var(--surface);
    overflow: hidden;
    transition: 0.2s;
}

.category-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
}

.category-card h3 {
    font-size: 14px;
    margin-bottom: 6px;
}

.category-card p {
    color: var(--muted);
    font-size: 11px;
}

.category-card img {
    width: 45%;
    height: 75px;
    object-fit: contain;
    mix-blend-mode: multiply;
}

:root[data-theme="dark"] .category-card img {
    mix-blend-mode: normal;
    border-radius: 8px;
}

/* =========================
   PRODUCTS
========================= */

.products-section {
    padding-top: 25px;
}

.section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 15px;
    margin-bottom: 18px;
}

.section-heading h2 {
    font-size: 24px;
    margin-bottom: 6px;
    letter-spacing: -0.8px;
}

.section-heading p {
    font-size: 13px;
    color: var(--muted);
}

.view-all {
    font-size: 12px;
    font-weight: bold;
    color: var(--blue);
    white-space: nowrap;
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 16px;
}

.product-card {
    border: 1px solid var(--border);
    background: var(--card);
    border-radius: 12px;
    padding: 12px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    transition: 0.2s;
}

.product-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
}

.product-image-box {
    height: 135px;
    position: relative;
    display: grid;
    place-items: center;
}

.product-image-box img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.favorite-button {
    position: absolute;
    right: 0;
    top: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    font-size: 23px;
}

.favorite-button.selected {
    color: #ef233c;
}

.product-card h3 {
    font-size: 12px;
    line-height: 1.4;
    margin: 8px 0 5px;
}

.product-specs {
    font-size: 10px;
    color: var(--muted);
    margin-bottom: 6px;
}

.rating {
    color: #f0a900;
    font-size: 12px;
    margin-bottom: 7px;
}

.rating span {
    color: var(--muted);
    font-size: 10px;
}

.product-price {
    font-size: 14px;
    font-weight: 800;
    margin-bottom: 10px;
}

.add-cart {
    width: 100%;
    padding: 10px 5px;
    margin-top: auto;
    border: 0;
    border-radius: 7px;
    background: var(--blue);
    color: white;
    font-size: 11px;
    font-weight: bold;
}

.add-cart:hover {
    background: #0048c9;
}

.no-results {
    text-align: center;
    color: var(--muted);
    padding: 30px;
}

/* =========================
   PROMOTIONS
========================= */

.promotions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    padding-top: 12px;
    padding-bottom: 35px;
}

.promotion {
    min-height: 165px;
    border-radius: 13px;
    overflow: hidden;
    background-position: center;
    background-size: cover;
    position: relative;
    display: flex;
    align-items: center;
    padding: 25px 30px;
    color: white;
}

.promotion::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0,0,0,.88), rgba(0,0,0,.2));
}

.promotion > div {
    position: relative;
    z-index: 1;
}

.promotion h2 {
    font-size: 20px;
    margin-bottom: 6px;
}

.promotion p {
    font-size: 13px;
    margin-bottom: 15px;
    color: #eeeeee;
}

.promotion-airpods {
    background-image: url("https://images.unsplash.com/photo-1606220945770-b5b6c2c55bf1?auto=format&fit=crop&w=1000&q=85");
}

.promotion-watch {
    background-image: url("https://images.unsplash.com/photo-1546868871-7041f2a55e12?auto=format&fit=crop&w=1000&q=85");
}

.light-button {
    background: white;
    color: #111111;
    padding: 10px 16px;
}

/* =========================
   FOOTER
========================= */

footer {
    border-top: 1px solid var(--border);
    text-align: center;
    padding: 28px 20px;
}

footer p {
    margin: 8px 0;
    color: var(--muted);
    font-size: 12px;
}

footer small {
    color: var(--muted);
    font-size: 10px;
}

/* =========================
   CART DRAWER
========================= */

.cart-backdrop {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: rgba(0, 0, 0, 0.45);
    opacity: 0;
    visibility: hidden;
    transition: 0.2s;
}

.cart-backdrop.open {
    opacity: 1;
    visibility: visible;
}

.cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 41;
    width: min(420px, 100%);
    padding: 24px;
    background: var(--bg);
    box-shadow: var(--shadow);
    transform: translateX(105%);
    transition: transform 0.25s;
    display: flex;
    flex-direction: column;
}

.cart-drawer.open {
    transform: translateX(0);
}

.cart-heading {
    display: flex;
    justify-content: space-between;
    align-items: start;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
}

.cart-heading h2 {
    margin-bottom: 5px;
}

.cart-heading p {
    color: var(--muted);
    font-size: 12px;
}

.close-button {
    width: 35px;
    height: 35px;
    border: 0;
    border-radius: 50%;
    background: var(--surface);
    color: var(--text);
    font-size: 24px;
}

.cart-items {
    overflow: auto;
    flex: 1;
}

.cart-item {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 12px;
    padding: 15px 0;
    border-bottom: 1px solid var(--border);
}

.cart-item img {
    width: 70px;
    height: 75px;
    object-fit: contain;
    border-radius: 8px;
    background: var(--surface);
}

.cart-item h3 {
    font-size: 12px;
    margin-bottom: 6px;
}

.cart-item p {
    font-size: 12px;
    font-weight: bold;
}

.quantity-controls {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 9px;
}

.quantity-controls button,
.remove-item {
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    border-radius: 5px;
    padding: 4px 8px;
}

.remove-item {
    margin-top: 8px;
    font-size: 10px;
}

.cart-footer {
    border-top: 1px solid var(--border);
    padding-top: 18px;
}

.cart-total {
    display: flex;
    justify-content: space-between;
    margin-bottom: 15px;
}

.checkout-button {
    width: 100%;
    border-radius: 8px;
}

.cart-footer > p {
    color: var(--muted);
    text-align: center;
    font-size: 10px;
    margin-top: 12px;
}

/* =========================
   TOAST MESSAGE
========================= */

.toast {
    position: fixed;
    z-index: 60;
    left: 50%;
    bottom: 25px;
    transform: translate(-50%, 15px);
    opacity: 0;
    pointer-events: none;
    background: var(--text);
    color: var(--bg);
    border-radius: 9px;
    padding: 13px 18px;
    font-size: 12px;
    transition: 0.2s;
}

.toast.show {
    opacity: 1;
    transform: translate(-50%, 0);
}

/* =========================
   RESPONSIVE DESIGN
========================= */

@media (max-width: 1200px) {
    .navbar {
        padding: 0 3%;
        gap: 18px;
    }

    nav {
        gap: 13px;
    }

    nav a {
        font-size: 11px;
    }

    #search {
        width: 155px;
    }

    .product-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .product-image-box {
        height: 160px;
    }
}

@media (max-width: 820px) {
    .navbar {
        height: 65px;
        padding: 0 16px;
        gap: 10px;
    }

    .logo {
        font-size: 21px;
    }

    .menu-button {
        display: block;
        order: 3;
    }

    nav {
        display: none;
        position: absolute;
        top: 65px;
        left: 0;
        right: 0;
        padding: 12px 20px;
        background: var(--bg);
        border-bottom: 1px solid var(--border);
        flex-wrap: wrap;
        gap: 0 18px;
    }

    nav.open {
        display: flex;
    }

    nav a {
        padding: 12px 0;
    }

    .header-actions {
        margin-left: auto;
        gap: 9px;
    }

    #search {
        width: 115px;
        padding: 8px 10px;
        font-size: 11px;
    }

    .hero {
        min-height: 430px;
        padding: 35px 25px;
        align-items: flex-start;
    }

    .hero-content {
        max-width: 100%;
    }

    .hero h1 {
        font-size: 40px;
    }

    .hero h2 {
        font-size: 28px;
    }

    .hero-description {
        font-size: 13px;
        max-width: 390px;
    }

    .hero-image {
        top: auto;
        right: 0;
        bottom: 0;
        height: 45%;
        width: 100%;
        opacity: 0.45;
        mask-image: linear-gradient(180deg, transparent, black 40%);
    }

    .benefits {
        grid-template-columns: repeat(2, 1fr);
        padding: 18px 20px;
        gap: 20px 10px;
    }

    .benefit {
        justify-content: flex-start;
    }

    .section-container {
        width: 92%;
    }

    .categories {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .category-card:last-child {
        grid-column: span 2;
    }

    .promotions {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 480px) {
    .navbar {
        padding: 0 10px;
        gap: 7px;
    }

    .logo {
        font-size: 18px;
    }

    .header-actions {
        gap: 7px;
    }

    #search {
        width: 95px;
        padding: 8px;
    }

    .icon-button {
        font-size: 20px;
    }

    .hero {
        min-height: 400px;
        padding: 32px 20px;
    }

    .hero h1 {
        font-size: 35px;
    }

    .hero h2 {
        font-size: 25px;
    }

    .hero-description {
        max-width: 300px;
        line-height: 1.6;
    }

    .button {
        padding: 11px 15px;
    }

    .benefit {
        gap: 8px;
    }

    .benefit > span {
        font-size: 22px;
    }

    .benefit strong {
        font-size: 10px;
    }

    .benefit small {
        font-size: 9px;
    }

    .section-heading h2 {
        font-size: 20px;
    }

    .section-heading p {
        font-size: 10px;
    }

    .view-all {
        font-size: 10px;
    }

    .product-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .product-card {
        padding: 9px;
    }

    .product-image-box {
        height: 125px;
    }

    .product-card h3 {
        font-size: 11px;
    }

    .product-price {
        font-size: 13px;
    }

    .promotion {
        min-height: 150px;
        padding: 20px;
    }

    .promotion h2 {
        font-size: 18px;
    }
}
```
